{
  "expo": {
    "name": "MediConnect",
    "slug": "mediconnect",
    "version": "1.0.0",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTabletMode": true,
      "infoPlist": {
        "NSCameraUsageDescription": "We need camera access for video consultations",
        "NSMicrophoneUsageDescription": "We need microphone access for video consultations"
      }
    },
    "android": {
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "@daily-co/react-native",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0066cc"
        }
      ]
    ]
  }
}