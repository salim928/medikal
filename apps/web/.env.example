# MediConnect Environment Variables

# Copy this file to .env.local and fill in your values
# DO NOT commit .env.local to version control

# ==============================================
# SUPABASE CONFIGURATION
# ==============================================
# Get these from: https://supabase.com/dashboard/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# ==============================================
# API CONFIGURATION
# ==============================================

# Backend API URL (local development)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Domain for OAuth callbacks
NEXT_PUBLIC_DOMAIN=http://localhost:3000

# ==============================================
# OPTIONAL: AI SERVICES
# ==============================================

# Groq API (for AI features)
# GROQ_API_KEY=your_groq_api_key

# ChromaDB (for vector search)
# CHROMA_URL=http://localhost:8000

# ==============================================
# OPTIONAL: VIDEO CONSULTATIONS
# ==============================================

# Daily.co API Key (for video calls)
# NEXT_PUBLIC_DAILY_API_KEY=your_daily_api_key

# ==============================================
# OPTIONAL: PAYMENT PROCESSING
# ==============================================

# Stripe keys
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
# STRIPE_SECRET_KEY=your_stripe_secret_key

# ==============================================
# OPTIONAL: NOTIFICATIONS
# ==============================================

# Twilio (for SMS)
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=your_twilio_phone_number

# SendGrid (for Email)
# SENDGRID_API_KEY=your_sendgrid_api_key

# ==============================================
# DEVELOPMENT OPTIONS
# ==============================================

# Enable test accounts (for demo purposes)
NEXT_PUBLIC_ENABLE_TEST_ACCOUNTS=true

# Skip email verification (for development)
NEXT_PUBLIC_SKIP_EMAIL_VERIFICATION=true

# Enable debug logging
NEXT_PUBLIC_DEBUG=false

# ==============================================
# PRODUCTION SETTINGS (Optional)
# ==============================================

# Node environment
# NODE_ENV=production

# Analytics
# NEXT_PUBLIC_GA_TRACKING_ID=your_google_analytics_id

# Error Tracking (Sentry)
# SENTRY_DSN=your_sentry_dsn
# NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn

# ==============================================
# NOTES
# ==============================================
# 
# 1. Supabase Setup:
#    - Create a project at https://supabase.com
#    - Copy your project URL and anon key
#    - Set up authentication (Email, OAuth, etc.)
#    - Create necessary database tables
#
# 2. The app will run without Supabase configured,
#    but authentication features will be disabled
#
# 3. For local development, only SUPABASE variables
#    are required. Others are optional.
#
# 4. See README.md for demo login info (demo mode
#    works with no env configuration at all)
#
